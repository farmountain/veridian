{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["core/**/*.ts", "adapters/**/*.ts", "validators/**/*.ts", "cli/**/*.ts"],
  "exclude": ["**/*.test.ts", "tests/**"]
}
